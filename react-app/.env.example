VITE_API_URL=https://liveshop-saas-api-production.up.railway.app/v1

# Opcional para QA local contra Railway sem depender de CORS no browser:
# VITE_API_URL=/v1
# VITE_DEV_API_PROXY_TARGET=https://liveshop-saas-api-production.up.railway.app
# VITE_DEV_API_PROXY_ORIGIN=https://livelab-3601f.web.app

# Bloqueio de onboarding obrigatório do cliente (default: desligado).
VITE_ENABLE_CLIENT_ONBOARDING=false

# Sentry (opcional). Vazio/ausente = Sentry desligado, o app roda normal.
# Só faz sentido em produção (Vercel → Settings → Environment Variables).
# DSN em: sentry.io → Projeto → Settings → Client Keys (DSN).
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

# Cadastro unificado (lista "Clientes" via GET /v1/cadastros). Default: desligado.
# Só o valor exato "true" liga. Ausente/"false"/"0" = junção atual /clientes + /marcas.
# Mesmo ligado, se o backend responder 404 em /v1/cadastros a tela cai na junção atual.
# Na Vercel: Settings → Environment Variables → VITE_CADASTRO_UNIFICADO=true → redeploy
# (variável VITE_* entra no build; mudar exige novo build).
VITE_CADASTRO_UNIFICADO=false
